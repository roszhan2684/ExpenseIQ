GMAIL_APP_PASSWORD=

# ── AI providers (optional, tried in order: Ollama → Groq → Gemini) ─────────
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=

# ── Plaid bank sync (optional) ───────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
